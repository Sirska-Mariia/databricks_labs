{
  "datasets": [
    {
      "name": "f739a5aa",
      "displayName": "ds_daily",
      "queryLines": [
        "SELECT order_date,\r\n",
        "       date_trunc('month', order_date) AS month_start,\r\n",
        "       concat(weekday(order_date) + 1, ') ', date_format(order_date, 'E')) AS weekday,\r\n",
        "       customer_state, orders, items, revenue, freight\r\n",
        "FROM dbr_dev_ua5816bd.mariiasirska_gold.agg_sales_daily_state"
      ]
    },
    {
      "name": "7bb89828",
      "displayName": "ds_monthly",
      "queryLines": [
        "SELECT month_start, customer_state, category, items, revenue, freight,\r\n",
        "       delivered_items, late_items, review_sum, review_cnt\r\n",
        "FROM dbr_dev_ua5816bd.mariiasirska_gold.agg_sales_monthly_category_state"
      ]
    },
    {
      "name": "dd707f3e",
      "displayName": "ds_delivery",
      "queryLines": [
        "SELECT order_id, order_date, customer_state, delivery_bucket, review_score\r\n",
        "FROM (\r\n",
        "  SELECT order_id, order_date, customer_state,\r\n",
        "         CASE WHEN delivery_days <= 7  THEN '1) 0-7 days'\r\n",
        "              WHEN delivery_days <= 14 THEN '2) 8-14 days'\r\n",
        "              WHEN delivery_days <= 21 THEN '3) 15-21 days'\r\n",
        "              WHEN delivery_days <= 30 THEN '4) 22-30 days'\r\n",
        "              ELSE '5) 30+ days' END AS delivery_bucket,\r\n",
        "         max(delivery_days) AS delivery_days,\r\n",
        "         max(review_score) AS review_score\r\n",
        "  FROM dbr_dev_ua5816bd.mariiasirska_gold.fact_order_items\r\n",
        "  WHERE order_status = 'delivered'\r\n",
        "    AND delivery_days IS NOT NULL\r\n",
        "    AND review_score IS NOT NULL\r\n",
        "  GROUP BY order_id, order_date, customer_state, 4\r\n",
        ")"
      ]
    },
    {
      "name": "cfb1f4cd",
      "displayName": "ds_orders",
      "queryLines": [
        "SELECT order_id, order_date, customer_state, sum(price) AS order_value\r\n",
        "FROM dbr_dev_ua5816bd.mariiasirska_gold.fact_order_items\r\n",
        "WHERE order_status NOT IN ('canceled', 'unavailable')\r\n",
        "GROUP BY order_id, order_date, customer_state"
      ]
    },
    {
      "name": "59e4bfb4",
      "displayName": "ds_reviews",
      "queryLines": [
        "SELECT order_id, order_date, customer_state, max(review_score) AS review_score\r\n",
        "FROM dbr_dev_ua5816bd.mariiasirska_gold.fact_order_items\r\n",
        "WHERE review_score IS NOT NULL\r\n",
        "GROUP BY order_id, order_date, customer_state"
      ]
    },
    {
      "name": "071180fc",
      "displayName": "ds_freight",
      "queryLines": [
        "SELECT order_date,\r\n",
        "       customer_state,\r\n",
        "       round(100.0 * freight_value / price, 1) AS freight_pct\r\n",
        "FROM dbr_dev_ua5816bd.mariiasirska_gold.fact_order_items\r\n",
        "WHERE order_status NOT IN ('canceled', 'unavailable')\r\n",
        "  AND price >= 10"
      ]
    },
    {
      "name": "71df6d55",
      "displayName": "dl_late",
      "queryLines": [
        "SELECT order_id, order_date, customer_state,\r\n",
        "       max(CASE WHEN is_late THEN 100 ELSE 0 END) AS late_pct\r\n",
        "FROM dbr_dev_ua5816bd.mariiasirska_gold.fact_order_items\r\n",
        "WHERE order_status = 'delivered' AND is_late IS NOT NULL\r\n",
        "GROUP BY order_id, order_date, customer_state"
      ]
    },
    {
      "name": "dd61be7d",
      "displayName": "ds_top_categories",
      "queryLines": [
        "SELECT month_start, customer_state, category, revenue\r\n",
        "FROM dbr_dev_ua5816bd.mariiasirska_gold.agg_sales_monthly_category_state\r\n",
        "WHERE category IN (\r\n",
        "  SELECT category\r\n",
        "  FROM dbr_dev_ua5816bd.mariiasirska_gold.agg_sales_monthly_category_state\r\n",
        "  GROUP BY category\r\n",
        "  ORDER BY sum(revenue) DESC\r\n",
        "  LIMIT 10\r\n",
        ")"
      ]
    }
  ],
